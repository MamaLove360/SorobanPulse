# Generated by `cargo run --bin gen_config_docs` from `src/config/reference.rs`. Do not edit by hand.
# Full reference: docs/configuration.md

# ── Core ──────────────────────────────────────────────────────────────────

# Deployment environment: development, staging or production. Staging and production reject ALLOWED_ORIGINS=* and require HTTPS webhooks by default.
ENVIRONMENT=development

# Which subsystems start on this instance: all (API + indexer), api (HTTP API only) or indexer (indexer plus health/metrics).
# ROLE=all

# Path to an optional TOML file supplying any variable in this reference. Environment variables take precedence over file values.
# CONFIG_FILE=

# HTTP server port to listen on.
PORT=3000

# Trust X-Forwarded-For / X-Real-IP for client IPs. Enable only behind a trusted reverse proxy.
# BEHIND_PROXY=false

# Comma-separated CORS origins. * allows all origins and is rejected in staging/production.
# ALLOWED_ORIGINS=*

# Maximum accepted HTTP request body size in bytes.
# MAX_BODY_SIZE_BYTES=1048576

# Path to a PEM certificate. When set together with TLS_KEY_FILE, the server terminates TLS itself.
# TLS_CERT_FILE=

# Path to the PEM private key matching TLS_CERT_FILE.
# TLS_KEY_FILE=

# Run database migrations before starting the server and indexer. Set to false when migrations run as a separate job (e.g. the Helm migration Job).
# RUN_MIGRATIONS_ON_STARTUP=true

# ── Database ──────────────────────────────────────────────────────────────

# PostgreSQL connection string, e.g. postgres://user:pass@localhost:5432/soroban_pulse. Required unless DATABASE_URL_FILE is set.
DATABASE_URL=postgres://<USER>:<PASSWORD>@db:5432/soroban_pulse

# Read the connection string from this file (Docker/Kubernetes secrets). Takes precedence over DATABASE_URL.
# DATABASE_URL_FILE=

# Optional read-replica connection string. HTTP handlers read from the replica; the indexer always writes to the primary.
# DATABASE_REPLICA_URL=

# Maximum connections in the PostgreSQL pool.
DB_MAX_CONNECTIONS=10

# Minimum idle connections kept in the pool.
DB_MIN_CONNECTIONS=2

# Close connections idle for longer than this many seconds.
# DB_IDLE_TIMEOUT_SECS=600

# Recycle connections older than this many seconds regardless of idle time.
# DB_MAX_LIFETIME_SECS=1800

# Ping each connection before handing it out, transparently replacing stale connections.
# DB_TEST_BEFORE_ACQUIRE=true

# Maximum time a single SQL statement may run before PostgreSQL cancels it.
# DB_STATEMENT_TIMEOUT_MS=5000

# Timeout for the health check database ping (SELECT 1).
# HEALTH_CHECK_TIMEOUT_MS=2000

# Database queries slower than this are logged at WARN level.
# SLOW_QUERY_THRESHOLD_MS=1000

# How often the index usage monitor runs.
# INDEX_CHECK_INTERVAL_HOURS=24

# ── Stellar RPC and indexer ───────────────────────────────────────────────

# Soroban RPC endpoint. Must be HTTPS and non-private unless ALLOW_INSECURE_RPC=true.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated fallback RPC endpoints, tried in order when the primary is unreachable.
# STELLAR_RPC_FALLBACK_URLS=

# Extra headers sent with every RPC request, as semicolon-separated Name: Value pairs (e.g. X-API-Key: key; X-Org: acme). Values are never logged.
# STELLAR_RPC_HEADERS=

# Allow HTTP and loopback/private RPC URLs. Local development only.
# ALLOW_INSECURE_RPC=false

# TCP connect timeout for RPC requests.
# RPC_CONNECT_TIMEOUT_SECS=5

# Total timeout for a single RPC request.
# RPC_REQUEST_TIMEOUT_SECS=30

# Maximum events requested per getEvents page.
# RPC_MAX_EVENTS_PER_PAGE=200

# Ledger sequence to start indexing from. 0 starts from the latest ledger.
START_LEDGER=0

# When START_LEDGER is outside the RPC retention window, fall back to the oldest available ledger instead of failing.
# START_LEDGER_FALLBACK=false

# Comma-separated event types to index: contract, diagnostic, system. Empty indexes all types.
# INDEXER_EVENT_TYPES=

# Poll interval when no new ledgers are available (100–60000).
# INDEXER_POLL_INTERVAL_MS=5000

# Backoff after an RPC error (100–60000).
# INDEXER_ERROR_BACKOFF_MS=10000

# Warn when the indexer falls this many ledgers behind the network.
# INDEXER_LAG_WARN_THRESHOLD=100

# Seconds without progress after which the indexer is reported as stalled.
# INDEXER_STALL_TIMEOUT_SECS=60

# How often standby replicas retry acquiring the indexer advisory lock.
# INDEXER_LOCK_RETRY_SECS=30

# Ignore the persisted indexer checkpoint and start from START_LEDGER.
# INDEXER_IGNORE_CHECKPOINT=false

# Events whose serialized event_data exceeds this size are logged and skipped.
# MAX_EVENT_DATA_BYTES=65536

# ── Multi-chain ───────────────────────────────────────────────────────────

# Chain identifier stamped on events indexed from STELLAR_RPC_URL.
# CHAIN_ID=mainnet

# Comma-separated extra chain IDs to index concurrently. Each needs a matching STELLAR_RPC_URL_<CHAIN_ID>.
# ADDITIONAL_CHAIN_IDS=

# Store ledger hashes and verify hash-chain continuity on startup.
# LEDGER_HASH_TRACKING_ENABLED=false

# Number of ledgers checked during startup hash-chain validation.
# LEDGER_HASH_VALIDATION_DEPTH=1000

# ── Authentication and access control ─────────────────────────────────────

# API key for authenticated endpoints. When unset, authentication is disabled.
# API_KEY=

# Second accepted API key, for rotating API_KEY without downtime.
# API_KEY_SECONDARY=

# Key required for /v1/admin/* endpoints, independent of API_KEY. When unset, admin endpoints fall back to the API_KEY gate.
# ADMIN_API_KEY=

# Second accepted admin key, for rotating ADMIN_API_KEY without downtime.
# ADMIN_API_KEY_SECONDARY=

# Comma-separated IPs/CIDR blocks to reject.
# IP_DENYLIST=

# Comma-separated IPs/CIDR blocks to exclusively allow. Empty disables enforcement.
# IP_ALLOWLIST=

# ── Rate limiting ─────────────────────────────────────────────────────────

# Per-IP request limit per minute. Exceeding it returns 429 with Retry-After.
# RATE_LIMIT_PER_MINUTE=60

# Per-API-key sliding-window limit per minute. Unset or 0 disables.
# RATE_LIMIT_KEY_PER_MINUTE=

# Per-API-key limit per hour. Unset or 0 disables.
# RATE_LIMIT_KEY_PER_HOUR=

# Per-API-key limit per day. Unset or 0 disables.
# RATE_LIMIT_KEY_PER_DAY=

# Per-API-key limit per rolling 30-day window. Unset or 0 disables.
# RATE_LIMIT_KEY_PER_MONTH=

# ── Multi-tenancy ─────────────────────────────────────────────────────────

# Enable multi-tenant mode. Every API key must then map to a tenant.
# MULTI_TENANT=false

# Independent per-tenant request quota per minute (multi-tenant mode only).
# TENANT_RATE_LIMIT_PER_MINUTE=

# Per-tenant indexer contract filter as semicolon-separated tenant:contract1,contract2 pairs.
# TENANT_CONTRACT_FILTER=

# Tenant ID stamped on every event this indexer inserts (multi-tenant mode only).
# INDEXER_TENANT_ID=

# ── API limits and caching ────────────────────────────────────────────────

# Maximum rows returned by GET /v1/events/export.
# EXPORT_MAX_ROWS=10000

# Maximum ledger span accepted by diff/range queries.
# MAX_LEDGER_RANGE=100000

# Maximum transaction hashes per batch lookup request.
# BATCH_TX_MAX_SIZE=100

# Maximum events per bulk insert request.
# BATCH_EVENTS_MAX_SIZE=10000

# Maximum entries in the per-contract event count cache.
# CONTRACT_COUNT_CACHE_SIZE=1000

# TTL of contract count cache entries.
# CONTRACT_COUNT_CACHE_TTL_SECS=30

# TTL of cached aggregation results.
# AGGREGATION_CACHE_TTL_SECS=60

# Maximum cached aggregation results.
# AGGREGATION_CACHE_MAX_ENTRIES=1000

# TTL of cached query results, clamped to 300–3600.
# QUERY_CACHE_TTL_SECS=300

# Maximum cached query results.
# QUERY_CACHE_MAX_CAPACITY=1000

# TTL of the cached /v1/stats response.
# STATS_CACHE_TTL_SECS=30

# How often materialized statistics are refreshed.
# STATS_REFRESH_INTERVAL_SECS=3600

# TTL of the in-process contract ABI cache.
# ABI_CACHE_TTL_SECS=86400

# Maximum ABIs kept in the in-process cache.
# ABI_CACHE_MAX_ENTRIES=10000

# Add Link preload headers for a contract's schema and ABI to /v1/events/contract/{contract_id} responses.
# ENABLE_PUSH_PRELOAD=false

# ── Server-sent events (SSE) ──────────────────────────────────────────────

# Keep-alive ping interval in seconds (1–60). Takes precedence over SSE_KEEPALIVE_INTERVAL_MS.
# SSE_KEEPALIVE_SECS=

# Keep-alive ping interval in milliseconds (1000–60000). Keep it below your proxy's idle timeout.
# SSE_KEEPALIVE_INTERVAL_MS=15000

# Maximum concurrent SSE connections.
# SSE_MAX_CONNECTIONS=1000

# Maximum concurrent SSE connections per client IP.
# SSE_MAX_CONNECTIONS_PER_IP=10

# Maximum contract IDs per multi-contract stream.
# SSE_MULTI_MAX_CONTRACT_IDS=100

# Time allowed for SSE clients to drain during shutdown (1–60).
# SSE_DRAIN_TIMEOUT_SECS=5

# Delay between broadcasting the close event and dropping the SSE broadcaster.
# SSE_SHUTDOWN_GRACE_PERIOD_MS=200

# Maximum events replayed on reconnect with Last-Event-ID. Takes precedence over SSE_REPLAY_LIMIT.
# SSE_REPLAY_MAX_EVENTS=1000

# Legacy alias of SSE_REPLAY_MAX_EVENTS.
# SSE_REPLAY_LIMIT=1000

# Events kept in the in-memory replay ring buffer; the oldest is evicted when full.
# SSE_RING_BUFFER_CAPACITY=10000

# Disconnect clients lagging this many events behind. 0 disables.
# SSE_MAX_LAG_BEFORE_DISCONNECT=0

# ── Logging and observability ─────────────────────────────────────────────

# Log filter (trace, debug, info, warn, error, or per-module directives).
RUST_LOG=info

# Log output format: text or json.
RUST_LOG_FORMAT=text

# Sample debug-level logs: 1 logs everything, 100 logs 1%. INFO and above are never sampled.
# LOG_SAMPLE_RATE=1

# HTTP requests slower than this are logged at WARN level.
# SLOW_REQUEST_THRESHOLD_MS=500

# OTLP collector endpoint (e.g. http://localhost:4317). Enables OpenTelemetry tracing when set.
# Requires the `otel` Cargo feature.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Retention, deduplication and storage ──────────────────────────────────

# Days to keep events before automatic pruning. 0 keeps events forever.
# RETENTION_DAYS=90

# How often the pruning task runs.
# PRUNING_INTERVAL_HOURS=24

# Age in days after which events are moved to archive storage.
# ARCHIVE_AFTER_DAYS=30

# False-positive rate of the bloom pre-deduplication filter.
# BLOOM_FILTER_FP_RATE=0.001

# Number of unique events the bloom filter is sized for.
# BLOOM_FILTER_CAPACITY=1000000

# Skip events whose content fingerprint matches a recent row.
# ENABLE_CONTENT_DEDUP=false

# Lookback window for content fingerprint deduplication.
# DEDUP_WINDOW_SECS=3600

# Gzip-compress event_data into event_data_compressed.
# EVENT_COMPRESSION_ENABLED=false

# Batch size when migrating existing events to compressed storage.
# EVENT_COMPRESSION_MIGRATION_BATCH_SIZE=500

# ── Encryption ────────────────────────────────────────────────────────────

# 64-hex-character AES-256-GCM key encrypting event_data at rest.
# Requires the `encryption` Cargo feature.
# EVENT_DATA_ENCRYPTION_KEY=

# Previous event data key, kept during rotation while POST /v1/admin/reencrypt runs.
# Requires the `encryption` Cargo feature.
# EVENT_DATA_ENCRYPTION_KEY_OLD=

# 64-hex-character AES-256-GCM key encrypting stored integration credentials (bot tokens, webhook URLs).
# Requires the `encryption` Cargo feature.
# INTEGRATION_ENCRYPTION_KEY=

# Previous integration key, used during rotation.
# Requires the `encryption` Cargo feature.
# INTEGRATION_ENCRYPTION_KEY_OLD=

# ── Webhooks ──────────────────────────────────────────────────────────────

# POST every newly indexed event as JSON to this URL.
# WEBHOOK_URL=

# HMAC-SHA256 secret. Each delivery carries X-Signature-256: sha256=<hex> over the raw body.
# WEBHOOK_SECRET=

# Comma-separated contract IDs; only matching events are delivered. Empty delivers all events.
# WEBHOOK_CONTRACT_FILTER=

# JSON content filter such as {"path":"$.amount","op":"gt","value":"1000000"}. Invalid filters are logged and ignored.
# WEBHOOK_CONTENT_FILTER=

# Maximum webhook deliveries per minute. Unset or 0 disables.
# WEBHOOK_RATE_LIMIT_PER_MINUTE=

# Maximum webhook deliveries per hour. Unset or 0 disables.
# WEBHOOK_RATE_LIMIT_PER_HOUR=

# Reject non-HTTPS webhook URLs. Defaults to true in staging/production and false otherwise.
# WEBHOOK_REQUIRE_HTTPS=

# Payload format: raw event JSON, slack or discord.
# WEBHOOK_NOTIFICATION_FORMAT=raw

# Optional message template used to render webhook notifications.
# WEBHOOK_MESSAGE_TEMPLATE=

# ── Email notifications ───────────────────────────────────────────────────

# SMTP host. Email notifications are enabled when set.
# EMAIL_SMTP_HOST=

# SMTP port (587 for STARTTLS).
# EMAIL_SMTP_PORT=587

# SMTP username.
# EMAIL_SMTP_USER=

# SMTP password. Never logged.
# EMAIL_SMTP_PASSWORD=

# Sender address. Required when EMAIL_SMTP_HOST is set.
# EMAIL_FROM=

# Comma-separated recipients. Required when EMAIL_SMTP_HOST is set.
# EMAIL_TO=

# Comma-separated contract IDs; only matching events trigger emails.
# EMAIL_CONTRACT_FILTER=

# Delivery schedule: immediate, hourly_digest, daily_digest or custom_cron.
# EMAIL_SCHEDULE=immediate

# UTC hour (0–23) at which the daily digest is sent.
# EMAIL_DAILY_DIGEST_HOUR=9

# Cron expression used when EMAIL_SCHEDULE=custom_cron.
# EMAIL_CRON=

# Start of the quiet window (HH:MM, UTC) during which emails are held.
# EMAIL_QUIET_HOURS_START=

# End of the quiet window (HH:MM, UTC).
# EMAIL_QUIET_HOURS_END=

# Maximum contracts listed individually in a digest email.
# EMAIL_MAX_CONTRACTS_IN_DIGEST=20

# Public base URL for unsubscribe links. Defaults to http://localhost:<PORT>.
# EMAIL_PUBLIC_BASE_URL=

# ── SMS notifications ─────────────────────────────────────────────────────

# Twilio account SID. SMS notifications are enabled when the Twilio credentials are set.
# TWILIO_ACCOUNT_SID=

# Twilio auth token.
# TWILIO_AUTH_TOKEN=

# Sending phone number in E.164 format.
# TWILIO_FROM_NUMBER=

# Comma-separated recipient phone numbers.
# SMS_TO_NUMBERS=

# Comma-separated contract IDs; only matching events trigger SMS.
# SMS_CONTRACT_FILTER=

# ── PagerDuty, escalation and on-call ─────────────────────────────────────

# PagerDuty Events API v2 routing key. PagerDuty alerts are enabled when set.
# PAGERDUTY_ROUTING_KEY=

# Source name shown on PagerDuty incidents.
# PAGERDUTY_SERVICE_NAME=Soroban Pulse

# Comma-separated contract IDs that trigger incidents.
# PAGERDUTY_CONTRACT_FILTER=

# Comma-separated event types that trigger incidents.
# PAGERDUTY_EVENT_TYPE_FILTER=

# JSON map from event type to PagerDuty severity.
# PAGERDUTY_SEVERITY_MAPPING={"contract":"error","diagnostic":"warning","system":"info"}

# Automatically resolve incidents after the threshold below.
# PAGERDUTY_AUTO_RESOLVE=true

# Minutes without matching events before an incident is auto-resolved.
# PAGERDUTY_AUTO_RESOLVE_THRESHOLD_MINUTES=30

# Default notification priority: low, medium, high or critical.
# NOTIFICATION_DEFAULT_PRIORITY=medium

# JSON path in event data evaluated by the priority rule.
# NOTIFICATION_PRIORITY_RULE_PATH=

# Value that NOTIFICATION_PRIORITY_RULE_PATH must match.
# NOTIFICATION_PRIORITY_RULE_VALUE=

# Priority assigned when the rule matches.
# NOTIFICATION_PRIORITY_RULE_PRIORITY=

# Channel notified first (e.g. email, webhook).
# ESCALATION_PRIMARY_CHANNEL=

# Channel escalated to when the primary is not acknowledged.
# ESCALATION_CHANNEL=

# Minutes before escalating to ESCALATION_CHANNEL.
# ESCALATION_DELAY_MINUTES=30

# On-call rotation provider (e.g. pagerduty).
# ONCALL_PROVIDER=

# PagerDuty REST API key used to read on-call schedules.
# ONCALL_PAGERDUTY_API_KEY=

# On-call schedule ID to route notifications to.
# ONCALL_SCHEDULE_ID=

# TTL of the cached on-call schedule.
# ONCALL_SCHEDULE_CACHE_TTL_SECS=300

# Days to keep notification_audit_log entries.
NOTIFICATION_AUDIT_LOG_RETENTION_DAYS=90

# How often each notification channel is health-checked.
NOTIFICATION_HEALTH_CHECK_INTERVAL_SECS=300

# Target address for email channel health checks.
# NOTIFICATION_HEALTH_CHECK_EMAIL=

# ── Streaming integrations ────────────────────────────────────────────────

# Comma-separated Kafka brokers (e.g. localhost:9092). Publishing is enabled when set.
# Requires the `kafka` Cargo feature.
# KAFKA_BROKERS=

# Kafka topic. Required when KAFKA_BROKERS is set.
# Requires the `kafka` Cargo feature.
# KAFKA_TOPIC=

# Kafka producer batch size in bytes.
# Requires the `kafka` Cargo feature.
# KAFKA_BATCH_SIZE=16384

# Kafka producer linger time.
# Requires the `kafka` Cargo feature.
# KAFKA_LINGER_MS=100

# Kinesis Data Stream to publish to. Requires AWS_REGION.
# Requires the `kinesis` Cargo feature.
# KINESIS_STREAM_NAME=

# Partition key strategy: contract_id, tx_hash or random.
# Requires the `kinesis` Cargo feature.
# KINESIS_PARTITION_KEY_FIELD=contract_id

# AWS region for Kinesis and SQS. Credentials come from the standard AWS chain.
# AWS_REGION=

# SQS queue URL. Publishing is enabled when set together with AWS_REGION.
# Requires the `sqs` Cargo feature.
# SQS_QUEUE_URL=

# Queue receiving entries that fail in a batch.
# Requires the `sqs` Cargo feature.
# SQS_DLQ_URL=

# Messages per SendMessageBatch call (AWS caps this at 10).
# Requires the `sqs` Cargo feature.
# SQS_BATCH_SIZE=10

# Azure Event Hubs connection string with Send permission.
# EVENT_HUBS_CONNECTION_STRING=

# Event hub name. Optional when EntityPath is in the connection string.
# EVENT_HUB_NAME=

# Partition key strategy: contract_id, tx_hash or ledger.
# EVENT_HUBS_PARTITION_STRATEGY=contract_id

# GCP project for Pub/Sub publishing. Requires PUBSUB_TOPIC_ID.
# Requires the `pubsub` Cargo feature.
# PUBSUB_PROJECT_ID=

# Pub/Sub topic ID (without the projects/…/topics/ prefix).
# Requires the `pubsub` Cargo feature.
# PUBSUB_TOPIC_ID=

# Publish with an ordering key per contract.
# Requires the `pubsub` Cargo feature.
# PUBSUB_ENABLE_MESSAGE_ORDERING=true

# Path to GCP service account JSON. Leave unset on GCE/GKE/Cloud Run.
# Requires the `pubsub` Cargo feature.
# GOOGLE_APPLICATION_CREDENTIALS=

# Redis URL. Each indexed event is published to a Redis Stream when set.
# Requires the `redis-queue` Cargo feature.
# REDIS_URL=

# Redis Stream key events are appended to.
# Requires the `redis-queue` Cargo feature.
# REDIS_STREAM_KEY=

# Events buffered in memory while Redis is unreachable; the oldest are dropped when full.
# Requires the `redis-queue` Cargo feature.
# REDIS_BUFFER_MAX_SIZE=10000

# ── Lua event transformation ──────────────────────────────────────────────

# Path to a Lua script that transforms or filters events before storage.
# Requires the `lua` Cargo feature.
# EVENT_TRANSFORM_SCRIPT=

# Per-event script timeout; events whose script times out are skipped.
# Requires the `lua` Cargo feature.
# EVENT_TRANSFORM_TIMEOUT_MS=100

# ── Dashboard ─────────────────────────────────────────────────────────────

# Serve the built web dashboard at /ui.
# Requires the `dashboard` Cargo feature.
# SERVE_DASHBOARD=false

# Directory containing the built dashboard.
# Requires the `dashboard` Cargo feature.
# DASHBOARD_DIR=web/dist

# Extra origins appended to the dashboard's CSP connect-src.
# Requires the `dashboard` Cargo feature.
# DASHBOARD_CONNECT_SRC=

# ── SaaS platform ─────────────────────────────────────────────────────────

# Enable tenant management and billing integration.
# SAAS_ENABLED=false

# Billing provider (e.g. stripe, paddle).
# BILLING_PROVIDER=

# Billing provider API key.
# BILLING_API_KEY=

# Trial length for new tenants.
# DEFAULT_TRIAL_DAYS=14

# Public base URL used in tenant onboarding links.
# SAAS_PUBLIC_BASE_URL=

# ── Machine learning ──────────────────────────────────────────────────────

# Enable ML-based anomaly detection.
# ML_ANOMALY_DETECTION_ENABLED=false

# Enable event pattern recognition.
# ML_PATTERN_RECOGNITION_ENABLED=false

# Enable ML-driven event filtering.
# ML_INTELLIGENT_FILTERING_ENABLED=false

# How often models are retrained.
# ML_MODEL_TRAINING_INTERVAL_HOURS=24

# Minimum samples required before training.
# ML_MIN_TRAINING_SAMPLES=100

# Minimum model confidence (0.0–1.0) for a result to be acted on.
# ML_CONFIDENCE_THRESHOLD=0.8

# Retrain models automatically on the interval above.
# ML_AUTO_RETRAIN=true

# ── Docker Compose ────────────────────────────────────────────────────────

# PostgreSQL user created by the Compose db service. Must match DATABASE_URL.
POSTGRES_USER=<USER>

# PostgreSQL password for the Compose db service.
POSTGRES_PASSWORD=<PASSWORD>

# Database created by the Compose db service.
POSTGRES_DB=soroban_pulse
