{
  "name": "@soroban-pulse/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Soroban Pulse API: REST, SSE streaming, retries and webhook verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soroban-Pulse/SorobanPulse.git",
    "directory": "sdk/typescript"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
