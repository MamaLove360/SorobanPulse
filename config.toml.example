# Optional TOML configuration file for Soroban Pulse.
# Copy to config.toml and set CONFIG_FILE=config.toml in your environment.
#
# Environment variables always take precedence over values in this file.
# Keys mirror the environment variable names exactly.

# DATABASE_URL = "postgres://<USER>:<PASSWORD>@localhost:5432/soroban_pulse"
# STELLAR_RPC_URL = "https://soroban-testnet.stellar.org"
# PORT = "3000"
# RUST_LOG = "info"
# RUST_LOG_FORMAT = "text"
# ENVIRONMENT = "development"

# DB_MAX_CONNECTIONS = "10"
# DB_MIN_CONNECTIONS = "2"
# DB_STATEMENT_TIMEOUT_MS = "5000"
# HEALTH_CHECK_TIMEOUT_MS = "2000"

# START_LEDGER = "0"
# INDEXER_POLL_INTERVAL_MS = "5000"
# INDEXER_ERROR_BACKOFF_MS = "10000"
# INDEXER_LAG_WARN_THRESHOLD = "100"
# INDEXER_STALL_TIMEOUT_SECS = "60"

# SLOW_REQUEST_THRESHOLD_MS = "500"

# ALLOWED_ORIGINS = "*"
# RATE_LIMIT_PER_MINUTE = "60"
# SSE_KEEPALIVE_INTERVAL_MS = "15000"
# SSE_MAX_CONNECTIONS = "1000"

# Per-API-key rate limiting (Issue #669).
# When set, each authenticated API key gets its own sliding-window quota
# tracked in the rate_limit_counters table (migration 20260626000001).
# Omit or set to 0 to disable per-key enforcement for that window.
# RATE_LIMIT_KEY_PER_MINUTE = "1000"
# RATE_LIMIT_KEY_PER_HOUR   = "10000"
# RATE_LIMIT_KEY_PER_DAY    = "100000"

# API_KEY = ""
# API_KEY_SECONDARY = ""

# --- Web dashboard (issue #1112) ---
# Serve the built dashboard at /ui (defaults to true in the Docker image).
# SERVE_DASHBOARD = "false"
# DASHBOARD_DIR = "web/dist"
# Extra API origins the dashboard may call (added to its CSP connect-src).
# DASHBOARD_CONNECT_SRC = ""

# --- Derived metrics DSL (issue #1262) ---
# User-defined metrics computed from indexed events on a schedule and exposed
# via the Prometheus /metrics endpoint. Each metric is a [[derived_metrics]]
# table with the following keys:
#
#   name        - Metric name (must be a valid Prometheus identifier).
#   description - Human-readable help text shown in /metrics.
#   expression  - The DSL expression used to compute the value.
#   interval    - Evaluation schedule, e.g. "10s", "1m", "5m".
#
# DSL syntax:
#   - Counters/gauges are referenced by name, e.g. `events_indexed_total`.
#   - Arithmetic: + - * / and parentheses.
#   - rate(<counter>, <window>)  -> per-second rate of a counter over a window.
#   - ratio(<numerator>, <denominator>) -> numerator / denominator (0 if denom is 0).
#   - sum(<field>) / count(<field>) / unique(<field>) over indexed events.
#
# Example 1: indexer throughput in events per second (5-minute window).
# [[derived_metrics]]
# name = "indexer_throughput_events_per_second"
# description = "Indexed events per second over the last 5 minutes"
# expression = "rate(events_indexed_total, 5m)"
# interval = "30s"
#
# Example 2: RPC error rate as a fraction of total RPC requests.
# [[derived_metrics]]
# name = "rpc_error_rate"
# description = "Fraction of RPC requests that resulted in an error"
# expression = "ratio(rpc_errors_total, rpc_requests_total)"
# interval = "1m"
