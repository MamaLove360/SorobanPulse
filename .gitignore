# SQLx offline query cache (generated, not hand-authored)
# Keep .sqlx/ directory committed so offline mode works in CI
# Uncomment the line below only if you regenerate it in CI:
# .sqlx/

# Terraform state and sensitive files
# Track source (.tf files and .tfvars.example templates)
# Ignore state, lock, and working directories
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform.lock.hcl
terraform/.terraform.lock.hcl
terraform/**/.terraform/
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.backup
# Never commit actual tfvars (may contain secrets)
terraform.tfvars
**/terraform.tfvars

# Test parallelization cache
.test-cache/
test-results/
*.test-result.json

# DSL compiled artifacts
*.dsl.compiled

# Batch operation temp files
batch-*.tmp

# Filter DSL schema cache
filter_dsl_schema_cache.json

# Parallel test worker databases (local dev)
test_schemas/

# Test parallelization temp output
tests/parallel_output/

# jsonschema generated artefacts
*.jsonschema.out

# Docs site (Docusaurus) build output
docs/site/node_modules/
docs/site/build/
docs/site/.docusaurus/
docs/site/static/openapi.json

# AI tool runtime / session state (specs are committed; agents/ is ephemeral)
.kiro/agents/
