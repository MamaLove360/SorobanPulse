# Port the bot listens on for SorobanPulse webhook deliveries.
PORT=8787

# Must equal WEBHOOK_SECRET in SorobanPulse's .env.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Discord channel webhook (Channel settings → Integrations → Webhooks → Copy URL).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Token contract to watch. Default: native XLM Stellar Asset Contract on testnet.
TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
TOKEN_SYMBOL=XLM
TOKEN_DECIMALS=7

# Only transfers of at least this many whole tokens are posted.
MIN_AMOUNT=100

# SorobanPulse API, used for the startup check.
SOROBAN_PULSE_URL=http://localhost:3000
# SOROBAN_PULSE_API_KEY=

# Block explorer used for transaction links.
EXPLORER_TX_URL=https://stellar.expert/explorer/testnet/tx/
