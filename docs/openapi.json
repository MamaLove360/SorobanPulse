{
  "openapi": "3.0.3",
  "info": {
    "title": "Soroban Pulse API",
    "description": "Indexes Soroban smart contract events on the Stellar network.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is healthy"
          },
          "503": {
            "description": "Service is degraded"
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Indexer operational status"
          }
        }
      }
    },
    "/v1/contracts": {
      "get": {
        "tags": [
          "events"
        ],
        "operationId": "get_contracts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page (1-100, default 20)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of indexed contract IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContractSummary"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "page": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "limit": {
                      "type": "integer",
                      "format": "int64"
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
                      "event_count": 4213,
                      "latest_ledger": 1234567
                    }
                  ],
                  "total": 1,
                  "page": 1,
                  "limit": 20
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "operationId": "get_events",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Results per page, 1–100 (default: 20)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "exact_count",
            "in": "query",
            "description": "Use exact COUNT(*) instead of approximate",
            "required": false,
            "schema": {
              "type": "boolean",
              "nullable": true
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "description": "Filter by event type: contract, diagnostic, system",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/EventType"
                }
              ],
              "nullable": true
            }
          },
          {
            "name": "from_ledger",
            "in": "query",
            "description": "Return events at or after this ledger",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "to_ledger",
            "in": "query",
            "description": "Return events at or before this ledger",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "ledger_hash",
            "in": "query",
            "description": "Filter events by ledger hash",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
          ,
          {
            "name": "anonymized",
            "in": "query",
            "description": "Filter events by anonymized status (admin only)",
            "required": false,
            "schema": {
              "type": "boolean",
              "nullable": true
            }
          }
          ,
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order: asc (oldest first) or desc (newest first, default)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "enum": ["asc", "desc"]
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort column: ledger (default), timestamp, or created_at",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "enum": ["ledger", "timestamp", "created_at"]
            }
          },
          {
            "name": "from_timestamp",
            "in": "query",
            "description": "Return events at or after this timestamp (ISO 8601 format, e.g., 2026-03-14T00:00:00Z)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "example": "2026-08-01T00:00:00Z"
          },
          {
            "name": "to_timestamp",
            "in": "query",
            "description": "Return events at or before this timestamp (ISO 8601 format, e.g., 2026-03-14T00:00:00Z)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "example": "2026-08-20T00:00:00Z"
          },
          {
            "name": "topic_sym",
            "in": "query",
            "description": "Filter by first topic symbol (uses topic_0_sym generated column index)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "example": "transfer"
          },
          {
            "name": "search",
            "in": "query",
            "description": "Full-text search query for event_data (searches all string values in the JSON)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "example": "transfer"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "page": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "limit": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "approximate": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f",
                      "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
                      "event_type": "contract",
                      "tx_hash": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
                      "ledger": 1234567,
                      "timestamp": "2026-08-20T12:00:00Z",
                      "event_data": {
                        "topics": ["transfer"],
                        "value": "1000000000"
                      },
                      "created_at": "2026-08-20T12:00:01Z"
                    }
                  ],
                  "total": 1,
                  "page": 1,
                  "limit": 20,
                  "approximate": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                "example": {
                  "type": "https://soroban-pulse.dev/errors/invalid-query-parameter",
                  "title": "Invalid query parameter",
                  "status": 400,
                  "detail": "unknown event_type: bogus",
                  "instance": "/v1/events"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/export": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Export events in bulk as CSV, Parquet, or JSONL.",
        "operationId": "export_events",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "Output format: csv (default), parquet, or jsonl",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "enum": ["csv", "parquet", "jsonl"]
            },
            "example": "jsonl"
          },
          {
            "name": "event_type",
            "in": "query",
            "description": "Filter by event type",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "example": "contract"
          },
          {
            "name": "from_ledger",
            "in": "query",
            "description": "Return events at or after this ledger",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            },
            "example": 1000000
          },
          {
            "name": "to_ledger",
            "in": "query",
            "description": "Return events at or before this ledger",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            },
            "example": 1001000
          },
          {
            "name": "contract_id",
            "in": "query",
            "description": "Filter by contract ID",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "example": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4"
          },
          {
            "name": "field_map",
            "in": "query",
            "description": "Optional JSON object mapping source field names to target output names",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "example": "{\"contract_id\":\"contract\"}"
          }
        ],
        "responses": {
          "200": {
            "description": "Exported events",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                },
                "example": "{\"id\":\"5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f\",\"contract_id\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4\",\"ledger\":1234567}\n"
              }
            }
          },
          "400": {
            "description": "Invalid query parameters or unsupported format",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "API key required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/contract/{contract_id}": {
      "get": {
        "tags": [
          "events"
        ],
        "operationId": "get_events_by_contract",
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "description": "Stellar contract ID (56-char, starts with C)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Results per page, 1–100 (default: 20)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor for keyset pagination (returned as next_cursor)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order: asc (oldest first) or desc (newest first, default)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "enum": ["asc", "desc"]
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort column: ledger (default), timestamp, or created_at",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "enum": ["ledger", "timestamp", "created_at"]
            }
          },
          {
            "name": "from_ledger",
            "in": "query",
            "description": "Return events at or after this ledger",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "to_ledger",
            "in": "query",
            "description": "Return events at or before this ledger",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events for the given contract",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "next_cursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f",
                      "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
                      "event_type": "contract",
                      "tx_hash": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
                      "ledger": 1234567,
                      "timestamp": "2026-08-20T12:00:00Z",
                      "event_data": {
                        "topics": ["transfer"],
                        "value": "1000000000"
                      },
                      "created_at": "2026-08-20T12:00:01Z"
                    }
                  ],
                  "next_cursor": "eyJsZWRnZXIiOjEyMzQ1Njh9"
                }
              }
            }
          },
          "400": {
            "description": "Invalid contract_id format or ledger range",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/contract/{contract_id}/stream": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Stream new events for a specific contract in real time via Server-Sent Events.",
        "operationId": "stream_events_by_contract",
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "description": "Stellar contract ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of contract events (text/event-stream)",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "data: {\"id\":\"5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f\",\"contract_id\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4\",\"event_type\":\"contract\",\"ledger\":1234567}\n\nevent: ping\ndata: 2026-08-20T12:00:15Z\n\n"
              }
            }
          },
          "400": {
            "description": "Invalid contract_id format",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/stream": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Stream new events in real time via Server-Sent Events.",
        "description": "This endpoint is less preferred for contract-specific streaming; use\n`/v1/events/contract/{contract_id}/stream` instead.",
        "operationId": "stream_events",
        "parameters": [
          {
            "name": "contract_id",
            "in": "query",
            "description": "Filter by contract ID (less preferred)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of new events (text/event-stream)",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "data: {\"id\":\"5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f\",\"contract_id\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4\",\"event_type\":\"contract\",\"ledger\":1234567}\n\nevent: ping\ndata: 2026-08-20T12:00:15Z\n\n"
              }
            }
          },
          "400": {
            "description": "Invalid contract_id format",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/contracts/{contract_id}/abi": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "get_contract_abi",
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "description": "Stellar contract ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registered ABI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "example": [
                  {
                    "name": "transfer",
                    "inputs": [
                      {"name": "from", "type": "Address"},
                      {"name": "to", "type": "Address"},
                      {"name": "amount", "type": "i128"}
                    ]
                  }
                ]
              }
            }
          },
          "404": {
            "description": "ABI not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "admin"
        ],
        "operationId": "register_contract_abi",
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "description": "Stellar contract ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional client-generated key (max 255 chars) used to make retries safe. Identical requests with the same key within 24 hours return the cached response and do not create a duplicate resource.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "nullable": true
            }
          }
        ],
        "requestBody": {
          "description": "ABI JSON array",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "example": [
                {
                  "name": "transfer",
                  "inputs": [
                    {"name": "from", "type": "Address"},
                    {"name": "to", "type": "Address"},
                    {"name": "amount", "type": "i128"}
                  ]
                }
              ]
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "ABI registered and existing events queued for decoding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"},
                    "queued_for_decoding": {"type": "integer", "format": "int64"}
                  }
                },
                "example": {
                  "status": "registered",
                  "queued_for_decoding": 42
                }
              }
            }
          },
          "400": {
            "description": "Invalid contract_id or ABI",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/costs/report": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Operational cost breakdown by component.",
        "description": "Returns aggregated operational costs (RPC calls, DB queries, notification delivery)\nbroken down by component, together with a linear forecast of future costs.",
        "operationId": "get_costs_report",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Start of the reporting window (ISO 8601). Defaults to 24 hours ago.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "example": "2026-08-19T00:00:00Z"
          },
          {
            "name": "to",
            "in": "query",
            "description": "End of the reporting window (ISO 8601). Defaults to now.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "example": "2026-08-20T00:00:00Z"
          },
          {
            "name": "forecast_hours",
            "in": "query",
            "description": "Number of hours to forecast beyond the window (default 24, max 168).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            },
            "example": 24
          }
        ],
        "responses": {
          "200": {
            "description": "Cost breakdown by component with forecast",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostReport"
                },
                "example": {
                  "window_start": "2026-08-19T00:00:00Z",
                  "window_end": "2026-08-20T00:00:00Z",
                  "total_cost": 12.3456,
                  "currency": "USD",
                  "components": [
                    {
                      "component": "rpc",
                      "call_count": 18420,
                      "total_cost": 7.368,
                      "unit_cost": 0.0004
                    },
                    {
                      "component": "db",
                      "call_count": 51230,
                      "total_cost": 4.0984,
                      "unit_cost": 0.00008
                    },
                    {
                      "component": "notification",
                      "call_count": 879,
                      "total_cost": 0.8792,
                      "unit_cost": 0.001
                    }
                  ],
                  "forecast": {
                    "horizon_hours": 24,
                    "predicted_total_cost": 12.9,
                    "slope_per_hour": 0.5375,
                    "intercept": 0.0
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid time window or forecast horizon",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "API key required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contracts/{contract_id}/stats/history": {
      "get": {
        "tags": [
          "events"
        ],
        "operationId": "get_contract_stats_history",
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "description": "Stellar contract ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "description": "Aggregation bucket. Currently only 1d is supported",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Number of daily buckets to return",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start date, YYYY-MM-DD",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End date, YYYY-MM-DD",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of {date, event_count, unique_tx_count} objects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {"type": "string", "format": "date"},
                      "event_count": {"type": "integer", "format": "int64"},
                      "unique_tx_count": {"type": "integer", "format": "int64"}
                    }
                  }
                },
                "example": [
                  {"date": "2026-08-19", "event_count": 812, "unique_tx_count": 340},
                  {"date": "2026-08-20", "event_count": 947, "unique_tx_count": 401}
                ]
              }
            }
          },
          "400": {
            "description": "Invalid contract_id, bucket, or date range",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/tx/{tx_hash}/related": {
      "get": {
        "tags": [
          "events"
        ],
        "operationId": "get_related_events_by_tx",
        "parameters": [
          {
            "name": "tx_hash",
            "in": "path",
            "description": "Root transaction hash (64 hex chars)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Reference traversal depth, default 1, max 3",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "maximum": 3,
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events from transactions referenced by event_data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f",
                      "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
                      "event_type": "contract",
                      "tx_hash": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
                      "ledger": 1234567,
                      "timestamp": "2026-08-20T12:00:00Z",
                      "event_data": {"topics": ["transfer"], "value": "1000000000"},
                      "created_at": "2026-08-20T12:00:01Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid tx_hash or depth",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/tx/{tx_hash}": {
      "get": {
        "tags": [
          "events"
        ],
        "operationId": "get_events_by_tx",
        "parameters": [
          {
            "name": "tx_hash",
            "in": "path",
            "description": "Transaction hash (64 lowercase hex chars)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events for the given transaction (empty array if none)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f",
                      "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
                      "event_type": "contract",
                      "tx_hash": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
                      "ledger": 1234567,
                      "timestamp": "2026-08-20T12:00:00Z",
                      "event_data": {"topics": ["transfer"], "value": "1000000000"},
                      "created_at": "2026-08-20T12:00:01Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid tx_hash format",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/tx/batch": {
      "post": {
        "tags": [
          "events"
        ],
        "operationId": "get_events_by_tx_batch",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional client-generated key (max 255 chars) used to make retries safe. Identical requests with the same key within 24 hours return the cached response and do not create a duplicate resource.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "nullable": true
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchTxRequest"
              },
              "example": {
                "hashes": [
                  "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
                  "2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Map of tx_hash -> events for all requested hashes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Event"
                    }
                  }
                },
                "example": {
                  "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b": [
                    {
                      "id": "5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f",
                      "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
                      "event_type": "contract",
                      "tx_hash": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
                      "ledger": 1234567,
                      "timestamp": "2026-08-20T12:00:00Z",
                      "event_data": {"topics": ["transfer"], "value": "1000000000"},
                      "created_at": "2026-08-20T12:00:01Z"
                    }
                  ],
                  "2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c": []
                }
              }
            }
          },
          "400": {
            "description": "Invalid hashes or too many hashes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContractSummary": {
        "type": "object",
        "required": [
          "contract_id",
          "event_count",
          "latest_ledger"
        ],
        "properties": {
          "contract_id": {
            "type": "string"
          },
          "event_count": {
            "type": "integer",
            "format": "int64"
          },
          "latest_ledger": {
            "type": "integer",
            "format": "int64"
          }
        },
        "example": {
          "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
          "event_count": 4213,
          "latest_ledger": 1234567
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "contract_id",
          "event_type",
          "tx_hash",
          "ledger",
          "timestamp",
          "event_data",
          "created_at"
        ],
        "properties": {
          "contract_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "event_data": {},
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ledger": {
            "type": "integer",
            "format": "int64"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "tx_hash": {
            "type": "string"
          }
        },
        "example": {
          "id": "5b1b1f6e-2b3a-4b3e-8e2a-1a2b3c4d5e6f",
          "contract_id": "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFCT4",
          "event_type": "contract",
          "tx_hash": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b",
          "ledger": 1234567,
          "timestamp": "2026-08-20T12:00:00Z",
          "event_data": {
            "topics": ["transfer"],
            "value": "1000000000"
          },
          "created_at": "2026-08-20T12:00:01Z"
        }
      },
      "EventType": {
        "type": "string",
        "enum": [
          "contract",
          "diagnostic",
          "system"
        ]
      },
      "PaginationParams": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "nullable": true
          },
          "event_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EventType"
              }
            ],
            "nullable": true
          },
          "exact_count": {
            "type": "boolean",
            "nullable": true
          },
          "fields": {
            "type": "string",
            "nullable": true
          },
          "from_ledger": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "page": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "to_ledger": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
           "sort": {
             "type": "string",
             "nullable": true,
             "enum": ["asc", "desc"]
           },
           "sort_by": {
             "type": "string",
             "nullable": true,
             "enum": ["ledger", "timestamp", "created_at"]
           },
           "topic_sym": {
             "type": "string",
             "description": "Filter by first topic symbol (uses topic_0_sym generated column index).",
             "nullable": true
           },
           "search": {
             "type": "string",
             "description": "Full-text search query for event_data (searches all string values in the JSON).",
             "nullable": true
           },
           "from_timestamp": {
             "type": "string",
             "description": "Filter events at or after this timestamp (ISO 8601 format).",
             "nullable": true
           },
           "to_timestamp": {
             "type": "string",
             "description": "Filter events at or before this timestamp (ISO 8601 format).",
             "nullable": true
           }
        }
      },
      "BatchTxRequest": {
        "type": "object",
        "required": [
          "hashes"
        ],
        "properties": {
          "hashes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of transaction hashes to look up (max 100)."
          }
        },
        "example": {
          "hashes": [
            "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b"
          ]
        }
      },
      "ProblemDetail": {
        "type": "object",
        "description": "RFC 9457 problem details object returned for all error responses.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "URI reference identifying the problem type."
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the problem type."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code generated for this occurrence."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation specific to this occurrence."
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "URI reference identifying the specific occurrence."
          }
        },
        "example": {
          "type": "https://soroban-pulse.dev/errors/invalid-query-parameter",
          "title": "Invalid query parameter",
          "status": 400,
          "detail": "unknown event_type: bogus",
          "instance": "/v1/events"
        }
      },
      "CostComponent": {
        "type": "object",
        "required": [
          "component",
          "call_count",
          "total_cost",
          "unit_cost"
        ],
        "properties": {
          "component": {
            "type": "string",
            "description": "Cost component: rpc, db, or notification."
          },
          "call_count": {
            "type": "integer",
            "format": "int64"
          },
          "total_cost": {
            "type": "number",
            "format": "double"
          },
          "unit_cost": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CostForecast": {
        "type": "object",
        "required": [
          "horizon_hours",
          "predicted_total_cost",
          "slope_per_hour",
          "intercept"
        ],
        "properties": {
          "horizon_hours": {
            "type": "integer",
            "format": "int64"
          },
          "predicted_total_cost": {
            "type": "number",
            "format": "double"
          },
          "slope_per_hour": {
            "type": "number",
            "format": "double"
          },
          "intercept": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CostReport": {
        "type": "object",
        "required": [
          "window_start",
          "window_end",
          "total_cost",
          "currency",
          "components",
          "forecast"
        ],
        "properties": {
          "window_start": {
            "type": "string",
            "format": "date-time"
          },
          "window_end": {
            "type": "string",
            "format": "date-time"
          },
          "total_cost": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostComponent"
            }
          },
          "forecast": {
            "$ref": "#/components/schemas/CostForecast"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "events",
      "description": "Event indexing endpoints"
    },
    {
      "name": "system",
      "description": "Health and observability endpoints"
    },
    {
      "name": "admin",
      "description": "Administrative endpoints"
    }
  ]
}
